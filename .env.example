# Backend port used by the Vite development proxy.
API_PORT=8787
API_HOST=127.0.0.1
# Render and most PaaS providers inject PORT automatically in production.
PORT=

# PostgreSQL is the only application database. The compose service below uses
# these local defaults; staging and production must provide separate databases.
DATABASE_URL=postgresql://antytilt:antytilt@127.0.0.1:5432/antytilt
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_SSL=false
DATABASE_APPLICATION_NAME=antytilt-api

# Redis backs the per-account RM queue, distributed locks and worker heartbeat.
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=antytilt
RM_WORKER_CONCURRENCY=4
RM_LOCK_TTL_MS=30000
WORKER_STALE_AFTER_MS=30000

# Keep false while developing. Live orders are rejected server-side unless true.
ALLOW_LIVE_TRADING=false

# Enables Trigger Market/Limit orders on live BingX accounts.
ALLOW_LIVE_TRIGGER_ORDERS=false

# Independent emergency switch for every automatic RM write on real accounts
# (protective Stop Loss, break-even, pending-order cancellation and position close).
# ALLOW_LIVE_TRADING and the user's explicit automation consent must also be enabled.
ALLOW_LIVE_RM_AUTOMATION=false

# Server-side account reconciliation interval. The worker also runs when the browser is closed.
RM_MONITOR_INTERVAL_MS=5000

# Comma-separated browser origins allowed to send trading mutations.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production only: base64-encoded 32-byte key used to encrypt exchange credentials.
# Generate with: openssl rand -base64 32
# Local development creates data/.credential-key automatically (and never commits it).
CREDENTIALS_ENCRYPTION_KEY=

# One-time import source for: npm run db:migrate:sqlite
SQLITE_SOURCE_PATH=data/antytilt.sqlite

# Hyperliquid: base64-encoded 32-byte key that encrypts agent (API) wallet keys at rest.
# Generate with: openssl rand -base64 32
HL_AGENT_ENCRYPTION_KEY=
# Enables Hyperliquid order and protection writes signed by approved agent wallets.
HL_REAL_ACTIONS_CONFIRMED=false
# Hyperliquid protection worker cadence (minimum 15000).
HL_MONITOR_INTERVAL_MS=15000

# Jupiter Perps: absolute path to the private wallet-protection config (mode 0600, outside
# the repository): {"rpc","genesis","trustedOrigin","mode":"live","keyFile"}.
JUPITER_UI_CONFIG=

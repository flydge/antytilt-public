# This file is consumed by scripts/local-production.sh and Docker Compose.
# Create the real ignored file with: ./scripts/local-production.sh init

APP_PORT=8787
POSTGRES_PASSWORD=replace-with-a-long-random-hex-value
CREDENTIALS_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32-output
BETA_ACCESS_USERNAME=antytilt-beta
BETA_ACCESS_PASSWORD=replace-with-a-random-shared-beta-password

# Only required for a permanent named Cloudflare Tunnel.
CLOUDFLARE_TUNNEL_TOKEN=
